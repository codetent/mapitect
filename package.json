{
  "name": "mapitect-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/ui",
    "packages/vscode",
    "packages/dev"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "watch": "npm run watch -w mapitect & npm run watch -w @mapitect/dev & wait",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "package": "npm run package -w mapitect",
    "dev": "npm run build -w @mapitect/dev && node packages/dev/server.mts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
