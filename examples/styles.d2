# Shared classes, imported by platform.d2 with `...@styles`.

classes: {
  external: {
    style.fill: "#334155"
    style.font-color: "#ffffff"
  }
  planned: {
    style.stroke-dash: 4
    style.opacity: 0.6
    style.italic: true
  }
  async: {
    style.stroke-dash: 4
    style.animated: true
  }
}
