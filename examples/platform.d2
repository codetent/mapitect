# mapitect example: a small online bookshop that uses everything the preview supports.
# Open the preview with Cmd+K V (Ctrl+K V on Windows/Linux).

# Classes live in styles.d2 next to this file.
...@styles

direction: right

vars: {
  cloud: AWS
  # Folders with architecture decision records, one subfolder per component.
  adr-folders: [adr; adr-shared]
}

customer: Reader {
  shape: person
  tooltip: Browses books, buys them and gets e-mail receipts.
}

staff: Shop staff {
  shape: person
  tooltip: Curates the catalog and reads the sales reports.
}

shop: Bookshop {
  tooltip: Everything we build and run on ${cloud}.

  cdn: CloudFront {
    shape: cloud
    icon: https://icons.terrastruct.com/aws%2FNetworking%20&%20Content%20Delivery%2FAmazon-CloudFront.svg
  }

  web: Storefront {
    icon: https://icons.terrastruct.com/dev%2Freact.svg
    tooltip: React app serving the public shop.
    link: https://react.dev
    style.underline: true
  }

  admin: Back office {
    tooltip: Internal admin panel for staff.
  }

  gateway: API Gateway {
    shape: hexagon
    tooltip: Auth, rate limiting and routing.
    style.3d: true
  }

  backend: Backend {
    catalog: Catalog Service {
      tooltip: Books, authors and search.
      style.multiple: true
    }

    recommendations: Recommendations {
      class: planned
      tooltip: "Planned: \"readers also bought\" suggestions."
    }

    orders: Order Service {
      api: Order API {
        tooltip: Checkout and order history.
      }
      jobs: Fulfilment jobs {
        shape: queue
      }
      worker: Fulfilment worker {
        tooltip: Reserves stock and hands orders to the warehouse.
      }

      api -> jobs: enqueue
      jobs -> worker: consume
    }

    payments: Payment Service {
      tooltip: Takes card payments through Stripe.
      style.stroke: "#e11d48"
      style.stroke-width: 3
    }

    export: Sales report job {
      tooltip: Builds yesterday's sales report every night.
    }

    orders.api -> payments: charge {
      style.stroke: "#e11d48"
    }
  }

  data: Data {
    db: PostgreSQL {
      shape: cylinder
      icon: https://icons.terrastruct.com/dev%2Fpostgresql.svg
      tooltip: Books and orders.
    }

    replica: Read replica {
      shape: cylinder
    }

    bus: Order events {
      shape: queue
      tooltip: SQS queue for domain events.
    }

    db -- replica: replication {
      style.opacity: 0.5
    }
  }

  cdn -> web: cached pages
  web -> gateway: HTTPS
  admin -> gateway: HTTPS
  gateway -> backend.catalog: REST
  gateway -> backend.orders.api: REST {
    style.stroke-width: 3
  }
  backend.catalog -> data.db: reads
  backend.recommendations -> data.replica: reads
  backend.orders.api -> data.db: writes {
    target-arrowhead: {
      shape: circle
      style.filled: true
    }
  }
  backend.orders.worker -> data.bus: OrderPlaced {class: async}
  data.bus -> backend.catalog: update stock {class: async}
  backend.export <- data.replica: rows
}

stripe: Stripe {
  shape: cloud
  class: external
  link: https://stripe.com
}

postmark: Postmark {
  shape: cloud
  class: external
}

customer -> shop.cdn: browses
staff -> shop.admin: manages
shop.backend.payments <-> stripe: charges / webhooks
shop.backend.orders.api -> postmark: receipt
postmark -> customer: e-mail {class: async}
shop.backend.export -> staff: sales report {
  target-arrowhead.shape: arrow
}
